    <!-- http://www.semanticweb.org/chech/ontologies/2026/3/EUDAMEDUOC#affectsDevice -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/chech/ontologies/2026/3/EUDAMEDUOC#affectsDevice">
