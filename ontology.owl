                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/chech/ontologies/2026/3/EUDAMEDUOC#Manufacturer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Dispositivo activo, subclase de dispositivo</rdfs:comment>
        <rdfs:label>ActiveDevice</rdfs:label>
    </owl:Class>
    


