    <!-- http://www.semanticweb.org/chech/ontologies/2026/3/EUDAMEDUOC#ActiveDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/chech/ontologies/2026/3/EUDAMEDUOC#ActiveDevice">
