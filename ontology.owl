                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/chech/ontologies/2026/3/EUDAMEDUOC#Manufacturer"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:comment>Dispositivo implicado en el incidente</rdfs:comment>
        <rdfs:isDefinedBy>Jlopezbaez</rdfs:isDefinedBy>
        <rdfs:label>affectsDevice</rdfs:label>
    </owl:ObjectProperty>
    


